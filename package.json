{
  "name": "hazard_be",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "NODE_ENV=prod node dist/index.js",
    "prisma:migrate:dev": "dotenv -e .env.dev -- npx prisma migrate dev",
    "prisma:migrate:reset": "dotenv -e .env.dev -- npx prisma migrate reset",
    "prisma:migrate:status": "dotenv -e .env.dev -- npx prisma migrate status",
    "prisma:migrate:resolve": "dotenv -e .env.dev -- npx prisma migrate resolve",
    "prisma:generate": "dotenv -e .env.dev -- npx prisma generate",
    "super-admin:create": "dotenv -e .env.dev -- tsx src/scripts/create-super-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.913.0",
    "@aws-sdk/s3-request-presigner": "^3.913.0",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@prisma/client": "^6.16.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "fetch": "^1.1.0",
    "firebase-admin": "^13.5.0",
    "geojson": "^0.5.0",
    "google-auth-library": "^10.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "openai": "^6.3.0",
    "qs": "^6.14.0",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/qs": "^6.14.0",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
