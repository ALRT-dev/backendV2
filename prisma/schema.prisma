// Run `npx prisma migrate dev` to update your database schema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String                 @default("")
  name                  String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  locationSubscriptions LocationSubscription[]
  devices               UserDevice[]
}

model HazardCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  emoji     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hazards   Hazard[]
}

enum HazardSeverity {
  info
  advice
  watchAndAct
  emergency
}

enum AIConfidence {
  low
  medium
  high
}

model Hazard {
  id               String          @id @default(uuid())
  title            String
  description      String
  shortDescription String?
  aiSummary        String?
  aiFeedback       String?
  aiSeverity       HazardSeverity?
  aiConfidence     AIConfidence?
  visibility       Boolean         @default(true)
  severity         HazardSeverity  @default(info)
  source           String?
  geoLocation      String? // PostGIS geometry as string (WKT or WKB)
  latitude         Float?
  longitude        Float?
  categoryId       String
  category         HazardCategory  @relation(fields: [categoryId], references: [id])
  occurredAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  expiresAt        DateTime?
}

model LocationSubscription {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  northeastLat Float
  northeastLng Float
  southwestLat Float
  southwestLng Float
  name         String? // Optional name for the location
  address      String? // Optional human-readable address
  geoRegion    String? // PostGIS geometry as string (WKT or WKB)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model UserDevice {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  deviceToken String   @unique
  platform    String? // e.g., "ios", "android"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
