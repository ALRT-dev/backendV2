// Run `npx prisma migrate dev` to update your database schema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String  @default("")
  name         String?

  xpPoints         Int   @default(0)
  reliabilityScore Float @default(0.0)

  latitude     Float?
  longitude    Float?
  geoLocation  String? // PostGIS geometry as string (WKT or WKB)
  locationName String? // Human-readable location name or address

  profilePictureUrl String? // S3 URL for user's profile picture

  locationSubscriptions    LocationSubscription[]
  devices                  UserDevice[]
  hazardsReported          Hazard[]
  hazardVotes              HazardVote[]
  hazardViews              HazardView[]
  hazardMedias             HazardMedia[]
  pushNotificationSettings UserPushNotificationSetting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HazardCategory {
  id    String  @id @default(uuid())
  name  String  @unique
  emoji String?

  hazards Hazard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HazardSeverity {
  info
  advice
  watchAndAct
  emergency
}

enum AIConfidence {
  low
  medium
  high
}

model Hazard {
  id               String          @id @default(uuid())
  title            String
  description      String
  shortDescription String?
  aiSummary        String?
  aiSeverity       HazardSeverity?
  aiConfidence     AIConfidence?
  severity         HazardSeverity  @default(info)

  latitude     Float?
  longitude    Float?
  locationName String? // Human-readable location name or address
  geoLocation  String? // PostGIS geometry as string (WKT or WKB)

  categoryId   String
  sourceId     String?
  reportedById String?

  reviewStatus   HazardReviewStatus @default(pending)
  reviewFeedback String?
  reviewedAt     DateTime?
  reviewedById   String? // user ID of the user who reviewed OR "ai" if AI-reviewed

  confidenceScore             Int      @default(50)
  confidenceScoreCalculatedAt DateTime @default(now())

  upvoteCount   Int @default(0)
  downvoteCount Int @default(0)
  viewCount     Int @default(0)

  occurredAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  expiresAt  DateTime?

  source     HazardSource?  @relation(fields: [sourceId], references: [id])
  category   HazardCategory @relation(fields: [categoryId], references: [id])
  reportedBy User?          @relation(fields: [reportedById], references: [id])
  votes      HazardVote[]
  views      HazardView[]
  medias     HazardMedia[]
}

model HazardVote {
  id        String         @id @default(uuid())
  hazardId  String
  hazard    Hazard         @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  voteType  HazardVoteType
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([hazardId, userId])
}

model HazardSource {
  id        String   @id @default(uuid())
  name      String
  url       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hazards   Hazard[]
}

model HazardView {
  id       String   @id @default(uuid())
  hazardId String
  userId   String
  viewedAt DateTime @default(now())

  user   User?  @relation(fields: [userId], references: [id])
  hazard Hazard @relation(fields: [hazardId], references: [id], onDelete: Cascade)

  @@unique([hazardId, userId])
  @@index([hazardId])
  @@index([userId])
}

model HazardMedia {
  id           String    @id @default(uuid())
  hazardId     String
  userId       String
  url          String
  s3Key        String? // S3 object key for easy deletion
  type         MediaType
  mimeType     String? // MIME type of the file
  fileSize     Int? // File size in bytes
  originalName String? // Original filename
  thumbnailUrl String? // For videos, a thumbnail image URL
  isPrimary    Boolean   @default(false) // True if this media is the primary media for the hazard

  hazard Hazard @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hazardId])
  @@index([userId])
}

enum MediaType {
  image
  video
}

enum HazardVoteType {
  upvote
  downvote
}

enum HazardReviewStatus {
  pending
  accepted
  rejected
}

model LocationSubscription {
  id           String  @id @default(uuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  northeastLat Float
  northeastLng Float
  southwestLat Float
  southwestLng Float
  name         String? // Optional name for the location
  address      String? // Optional human-readable address
  geoRegion    String? // PostGIS geometry as string (WKT or WKB)

  isOwnLocation Boolean  @default(false) // True if this subscription is for the user's own location
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, isOwnLocation])
}

model UserDevice {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  deviceToken String   @unique
  platform    String? // e.g., "ios", "android"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model UserPushNotificationSetting {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  settingType String // e.g., "hazard_severity", "location_updates", "system_notifications"
  settingKey  String // e.g., "info", "advice", "watchAndAct", "emergency" for hazard_severity
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, settingType, settingKey])
  @@index([userId])
  @@index([settingType])
}
